# SyncPay (servidor)
SYNCPAY_CLIENT_ID=
SYNCPAY_CLIENT_SECRET=
SYNCPAY_BASE_URL=https://api.syncpayments.com.br

# URL pública do app (webhook: {NEXT_PUBLIC_APP_URL}/api/syncpay/webhook)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: validação do webhook (Bearer)
# SYNCPAY_WEBHOOK_TOKEN=

# Link aberto automaticamente após PIX confirmado (público — não coloque segredo aqui)
NEXT_PUBLIC_ENTREGAVEL_URL=https://www.example.com/seu-conteudo

